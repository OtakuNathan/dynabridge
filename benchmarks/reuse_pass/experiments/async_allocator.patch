+namespace async_detail {
+struct default_state_factory {
+    template<class State, class... Args>
+    std::shared_ptr<State> make(Args&&... args) const {
+        return std::make_shared<State>(std::forward<Args>(args)...);
+    }
+};
+template<class Allocator> struct allocator_state_factory {
+    const Allocator& allocator;
+    template<class State, class... Args>
+    std::shared_ptr<State> make(Args&&... args) const {
+        return std::allocate_shared<State>(allocator, std::forward<Args>(args)...);
+    }
+};
+}
