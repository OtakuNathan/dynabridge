+            // Each dispatch owns its arguments, including recursive dispatches.
+            // Construct only the occupied inline slots; uncommon large calls use
+            // the same owning vector as the public decoder.
+            class request_arguments {
+            public:
+                request_arguments() noexcept = default;
+                request_arguments(const request_arguments&) = delete;
+                request_arguments& operator=(const request_arguments&) = delete;
+
+                ~request_arguments() {
+                    for (std::size_t i = 0; i < inline_size_; ++i) {
+                        inline_value(i).~value();
+                    }
+                }
+
+                void reserve(std::size_t count) {
+                    if (count > inline_capacity) {
+                        heap_.reserve(count);
+                        use_heap_ = true;
+                    }
+                }
+
+                void emplace_back(value&& input) {
+                    if (use_heap_) {
+                        heap_.emplace_back(std::move(input));
+                    } else {
+                        new (&inline_[inline_size_]) value(std::move(input));
+                        ++inline_size_;
+                    }
+                }
+
+                std::size_t size() const noexcept {
+                    return use_heap_ ? heap_.size() : inline_size_;
+                }
+
+                value& operator[](std::size_t index) noexcept {
+                    return use_heap_ ? heap_[index] : inline_value(index);
+                }
+
+                template <std::size_t I>
+                value& get() noexcept {
+                    return get_at<I>(std::integral_constant<bool, (I < inline_capacity)>{});
+                }
+
+                // Custom binders retain their exact vector/accessor API and
+                // owning inputs. Only library binders use inline storage.
+                std::vector<value>& legacy_vector() {
+                    if (!use_heap_) {
+                        heap_.reserve(inline_size_);
+                        for (std::size_t i = 0; i < inline_size_; ++i) {
+                            heap_.emplace_back(std::move(inline_value(i)));
+                        }
+                        use_heap_ = true;
+                    }
+                    return heap_;
+                }
+
+            private:
+                static constexpr std::size_t inline_capacity = 4;
+                using slot = typename std::aligned_storage<sizeof(value), alignof(value)>::type;
+
+                template <std::size_t I>
+                value& get_at(std::true_type) noexcept {
+                    return (*this)[I];
+                }
+
+                template <std::size_t I>
+                value& get_at(std::false_type) noexcept {
+                    return heap_[I];
+                }
+
+                value& inline_value(std::size_t index) noexcept {
+                    return *reinterpret_cast<value*>(&inline_[index]);
+                }
+
+                slot inline_[inline_capacity];
+                std::vector<value> heap_;
+                std::size_t inline_size_ = 0;
+                bool use_heap_ = false;
             };

