// Import declarations generate static import_symbols metadata, call_<name>(ctx,
// args...), and binders such as <name>(ctx). BEGIN_CLASS generates constructor
// helpers, delegate types for imported objects, and nested member symbols such
// as import_symbols::counter::add.
// Use DECL_CALLABLE(R, Args...) for normal declarations. DECL_FUNCTION(sig) is
// independent sugar for legacy C++ function-signature style. Use
// DECL_CONSTRUCTOR(Args...) inside BEGIN_CLASS to whitelist constructor calls.

BEGIN_CALLABLE_GROUP(foo)
    DECL_CALLABLE(void, int, int)
    DECL_CALLABLE(void, int)
    DECL_FUNCTION(void (unsigned))
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(bar)
    DECL_CALLABLE(void, int, int)
    DECL_CALLABLE(void, int)
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(calc)
    DECL_CALLABLE(int, int, unsigned)
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(echo)
    DECL_CALLABLE(std::string, std::string)
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(callback)
    DECL_CALLABLE(int, int)
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(pass_counter)
    DECL_CALLABLE(int, OBJECT(counter), int)
END_CALLABLE_GROUP

BEGIN_CALLABLE_GROUP(pass_transform)
    DECL_CALLABLE(int, CALLABLE(transform), int)
END_CALLABLE_GROUP

BEGIN_INTERFACE(counter_addable)
    BEGIN_MEMBER_CALLABLE_GROUP(add)
        DECL_MEMBER_FUNCTION(int, int)
    END_MEMBER_CALLABLE_GROUP
END_INTERFACE

BEGIN_INTERFACE(counter_readable)
    BEGIN_MEMBER_CALLABLE_GROUP(value)
        DECL_MEMBER_FUNCTION(int)
    END_MEMBER_CALLABLE_GROUP
END_INTERFACE

BEGIN_INTERFACE(counter_combinable)
    BEGIN_MEMBER_CALLABLE_GROUP(combine)
        DECL_MEMBER_FUNCTION(int, OBJECT(counter), int)
    END_MEMBER_CALLABLE_GROUP
END_INTERFACE

BEGIN_CLASS(counter)
    IMPLEMENTS(counter_addable)
    IMPLEMENTS(counter_readable)
    DECL_CONSTRUCTOR(unsigned)
END_CLASS

BEGIN_CLASS(consumer)
    IMPLEMENTS(counter_combinable)
    DECL_CONSTRUCTOR(OBJECT(counter), CALLABLE(transform))

    BEGIN_MEMBER_CALLABLE_GROUP(apply)
        DECL_MEMBER_FUNCTION(int, CALLABLE(transform), int)
    END_MEMBER_CALLABLE_GROUP
END_CLASS
